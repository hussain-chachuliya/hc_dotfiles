// Animations.
// https://yalter.github.io/niri/Configuration:-Animations

animations {
    workspace-switch {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-open {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    overview-open-close {
        duration-ms 200
        curve "ease-out-expo"
    }
    config-notification-open-close {
        duration-ms 150
        curve "ease-out-expo"
    }
    exit-confirmation-open-close {
        duration-ms 150
        curve "ease-out-expo"
    }
    screenshot-ui-open {
        duration-ms 150
        curve "ease-out-cubic"
    }
}
